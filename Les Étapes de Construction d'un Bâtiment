<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projet STI2D - Étapes de Construction</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;500;700;900&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0f1115;
            --bg-light: #f8f9fa;
            --text-dark: #1a1a1a;
            --text-light: #ffffff;
            --accent-orange: #ff5722;
            --accent-blue: #2196f3;
            --accent-green: #00c853;
            --accent-purple: #9c27b0;
            --grid-color: rgba(0, 0, 0, 0.04);
            --card-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-dark);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        /* Grille d'architecte en arrière-plan */
        .slide-content::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(var(--grid-color) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: 0;
            pointer-events: none;
        }

        .presentation-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
        }

        .slide {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            opacity: 0;
            transition: opacity 0.8s ease, transform 0.8s ease;
            transform: translateX(60px) scale(0.98);
            pointer-events: none;
            z-index: 1;
        }

        .slide.active {
            opacity: 1;
            transform: translateX(0) scale(1);
            pointer-events: auto;
            z-index: 10;
        }

        .slide.prev { transform: translateX(-60px) scale(0.98); }

        /* --- Diapositive 1: Titre --- */
        .slide-title {
            background: linear-gradient(rgba(15,17,21,0.7), rgba(15,17,21,0.9)), url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&q=80&w=1920') center/cover;
            color: var(--text-light);
            text-align: center;
        }
        .slide-title h2 { font-family: 'Outfit', sans-serif; font-size: 1.2rem; color: var(--accent-orange); font-weight: 500; text-transform: uppercase; letter-spacing: 4px; margin-bottom: 15px; }
        .slide-title h1 { font-family: 'Outfit', sans-serif; font-size: 4rem; font-weight: 900; margin-bottom: 20px; letter-spacing: -1px; line-height: 1.1; }
        .slide-title p { color: #ccc; font-size: 1.1rem; max-width: 600px; line-height: 1.6; font-weight: 300; }
        .slide-title .badge { display: inline-block; padding: 10px 20px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border-radius: 30px; margin-top: 30px; font-size: 0.9rem; }

        /* --- Layouts Généraux --- */
        .slide-content { background-color: var(--bg-light); }
        
        .slide-header { width: 100%; max-width: 1200px; margin-bottom: 30px; text-align: left; z-index: 2; position: relative; }
        .slide-header h3 { color: var(--accent-orange); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px; font-weight: 600; }
        .slide-header h1 { font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800; color: var(--text-dark); }

        /* --- Diapositive 2: Vue d'ensemble --- */
        .overview-container { display: flex; gap: 20px; width: 100%; max-width: 1200px; z-index: 2; position: relative; }
        .overview-card {
            flex: 1; background: white; padding: 30px; border-radius: 20px; box-shadow: var(--card-shadow);
            position: relative; overflow: hidden; transition: transform 0.3s ease;
        }
        .overview-card:hover { transform: translateY(-10px); }
        .overview-card .num { font-family: 'Outfit', sans-serif; font-size: 4rem; font-weight: 900; opacity: 0.1; position: absolute; top: 10px; right: 20px; }
        .overview-card h4 { font-family: 'Outfit', sans-serif; font-size: 1.4rem; margin-bottom: 10px; }
        .overview-card p { color: #666; font-size: 0.95rem; line-height: 1.5; }
        .overview-card.c1 { border-top: 6px solid var(--accent-orange); }
        .overview-card.c2 { border-top: 6px solid var(--accent-blue); }
        .overview-card.c3 { border-top: 6px solid var(--accent-green); }
        
        .alert-badge {
            background: #fff3e0; color: #e65100; padding: 15px 25px; border-radius: 12px;
            margin-top: 30px; display: flex; align-items: center; gap: 15px; font-weight: 600; font-size: 0.95rem;
            max-width: 1200px; width: 100%; z-index: 2; position: relative; border-left: 5px solid var(--accent-orange);
        }

        /* --- Diapositives 3 à 6: Détails Techniques (Split Layout) --- */
        .split-layout { display: flex; gap: 40px; width: 100%; max-width: 1200px; align-items: center; z-index: 2; position: relative; }
        .split-image {
            flex: 1; height: 400px; border-radius: 20px; background-size: cover; background-position: center;
            box-shadow: var(--card-shadow); position: relative; overflow: hidden;
        }
        .split-image::after { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to right, rgba(0,0,0,0.4), transparent); }
        .split-info { flex: 1; display: flex; flex-direction: column; gap: 20px; }
        
        .info-row { display: flex; align-items: center; gap: 20px; background: white; padding: 20px; border-radius: 16px; box-shadow: 0 10px 20px rgba(0,0,0,0.04); }
        .info-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; }
        .info-text h5 { font-size: 0.85rem; color: #888; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
        .info-text p { font-size: 1.1rem; font-weight: 600; color: var(--text-dark); }
        .info-text span { color: var(--accent-orange); }

        /* --- Diapositive 7: Hors d'Eau/Air --- */
        .water-air-container { display: flex; gap: 30px; width: 100%; max-width: 1200px; z-index: 2; position: relative; }
        .water-air-box { flex: 1; background: white; padding: 30px; border-radius: 20px; box-shadow: var(--card-shadow); display: flex; flex-direction: column; align-items: center; text-align: center; }
        .water-air-box h4 { font-family: 'Outfit', sans-serif; font-size: 1.5rem; margin: 15px 0; }
        .water-air-box.water h4 { color: var(--accent-blue); }
        .water-air-box.air h4 { color: var(--accent-green); }
        .big-icon { font-size: 3rem; }
        .transition-bar { background: var(--bg-dark); color: white; padding: 20px; border-radius: 16px; width: 100%; max-width: 1200px; text-align: center; margin-top: 30px; font-weight: 600; font-size: 1.1rem; z-index: 2; position: relative; }

        /* --- Diapositive 9: Synthèse (Timeline) --- */
        .timeline-container { width: 100%; max-width: 1200px; background: white; border-radius: 20px; padding: 30px; box-shadow: var(--card-shadow); z-index: 2; position: relative; }
        .timeline-row { display: flex; align-items: center; margin-bottom: 15px; }
        .timeline-label { width: 200px; font-weight: 600; font-size: 0.95rem; }
        .timeline-track { flex: 1; height: 30px; background: #f0f0f0; border-radius: 15px; position: relative; overflow: hidden; }
        .timeline-fill { height: 100%; border-radius: 15px; display: flex; align-items: center; padding-left: 15px; color: white; font-size: 0.8rem; font-weight: 600; }
        .timeline-fill.c1 { background: var(--accent-orange); width: 15%; }
        .timeline-fill.c2 { background: #f44336; width: 25%; }
        .timeline-fill.c3 { background: #ff9800; width: 30%; }
        .timeline-fill.c4 { background: #ffc107; width: 40%; color: #333; }
        .timeline-fill.c5 { background: var(--accent-blue); width: 35%; }
        .timeline-fill.c6 { background: var(--accent-green); width: 20%; }
        .timeline-fill.c7 { background: var(--accent-purple); width: 60%; }

        /* --- Navigation --- */
        .controls { position: fixed; bottom: 30px; right: 30px; display: flex; gap: 10px; z-index: 100; }
        .btn { background: white; border: none; width: 50px; height: 50px; border-radius: 50%; box-shadow: 0 4px 15px rgba(0,0,0,0.15); cursor: pointer; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; color: var(--text-dark); }
        .btn:hover { background: var(--accent-orange); color: white; transform: scale(1.1); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .progress-bar { position: fixed; top: 0; left: 0; height: 4px; background: var(--accent-orange); transition: width 0.3s ease; z-index: 100; }
        .slide-number { position: fixed; bottom: 30px; left: 30px; font-weight: 600; color: #888; z-index: 100; }
        .slide-title.active ~ .slide-number { color: #fff; }

        @media (max-width: 900px) {
            .overview-container, .split-layout, .water-air-container { flex-direction: column; }
            .split-image { height: 200px; width: 100%; }
            .slide-title h1 { font-size: 2.5rem; }
            .slide-header h1 { font-size: 1.8rem; }
        }
    </style>
</head>
<body>

